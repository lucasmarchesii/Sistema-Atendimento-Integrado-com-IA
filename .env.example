# Modelo de configuração. Copie para .env e ajuste os valores.
# O arquivo .env NÃO vai para o Git (está no .gitignore).

# Banco de dados (usado pelo Docker Compose e pela aplicação)
POSTGRES_DB=atendimento
POSTGRES_USER=atendimento
POSTGRES_PASSWORD=troque-esta-senha

# Classificador: simulado (padrão, sem custo) ou claude
CLASSIFICADOR_PROVEDOR=simulado

# Só necessária se CLASSIFICADOR_PROVEDOR=claude
ANTHROPIC_API_KEY=